# Copiá este archivo a .env.local para desarrollo si alguna vez necesitás
# apuntar a un backend que no sea localhost:4000.
#
# En Vercel esto NO se lee de un archivo: hay que configurarlo en
# Project Settings -> Environment Variables del proyecto del FRONTEND,
# con la URL del backend ya desplegado (sin barra final):
# VITE_API_BASE_URL=https://marketing-intelligence-faro-backend.vercel.app
VITE_API_BASE_URL=
